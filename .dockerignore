# =============================================================================
# Bazarr Production Docker Build - Ignore File
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Development files
.worktrees/
.playwright-mcp/
dev-setup/
dev-requirements.txt
.release-it.json
changelog-*.hbs
.auto-changelog

# Documentation
*.md
!README.md
docs/
screenshot/

# Tests
tests/
*$py.class
.pytest_cache/

# Compiled bytecode, at any depth. The bare `__pycache__/` and `*.py[cod]`
# these replace only matched the top level, so a local test run left every
# nested __pycache__ in the build context and the image shipped bytecode
# compiled on somebody's laptop. The application tree is read-only at runtime,
# so it is also bytecode nothing can ever refresh.
**/__pycache__/
**/*.py[cod]
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# CI/CD (keep workflows but ignore scripts)
.github/ISSUE_TEMPLATE/
.github/files_to_copy

# Frontend development files (build is copied separately)
frontend/node_modules/
frontend/.env*
frontend/*.log
frontend/.eslintcache

# Data directories (mounted at runtime)
data/
config/

# Build artifacts (in case of local builds)
__builds__/
*.zip
*.tar.gz

# Docker files (avoid recursive copy)
docker-compose*.yml
!docker-compose.yml
Dockerfile*
!Dockerfile

# Misc
*.log
*.tmp
.env
.env.*
